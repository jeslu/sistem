
<div id="<%= dom_id product %>">

      <div class="card shadow-sm shadow-lg p-3 mb-5 bg-body rounded">
      <%= link_to product_path(product), class: 'product', 'data-turbo-frame': '_top' do %>
        <h5 class="card-header"><%= product.code%></h5>
          <img>
           <%= image_tag product.photo, width: 100 if product.photo.attached? %>
           <%end%>
          <div class="card-body">
           <p class="card-title"><strong><%= product.name_p %></strong></p>
            <p class="card-text"><%= product.mark.mark%></p>
            <p class="card-text"> <%=number_to_currency(product.precio) %></p>
            <%= link_to "EDITAR", edit_product_path(product), "data-controller": "turbo"%>/
             <small class="text-body-secondary">Pz: <%= product.stock%></small>
          </div>
      </div>
      
  </div>



