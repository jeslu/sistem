



<div class="shadow-lg p-3 mb-5 bg-body rounded">


<h4>DETALLE DE PRODUCTO</h4>
      <div class="row align-items-start">
        <div class="col">
          
              <div class="card shadow-sm shadow-lg p-3 mb-5 bg-body rounded">
                <h5 class="card-header">Codigo: <%= @product.code%></h5
                  <img>
                
                  <div class="card-body">
                    <p class="card-title"><strong><%= @product.name_p %></strong></p>
                    <p class="card-text"><%= @product.mark.mark%></p>
                    <p class="card-text"><%= @product.description%></p>
                    <p class="card-text"> <%=number_to_currency(@product.precio) %></p>
                      <small class="text-body-secondary"><%= @product.extent.extent%>: <%= @product.stock%></small>
                       
                  </div>
              </div>
        
          <div class="input-group mb-3" >     
           <%= link_to "Editar", edit_product_path(@product), :class => "btn btn-info" %>  <%= button_to "Eliminar", @product, method: :delete , :class => "btn btn-danger"%>
                 <%= link_to 'Elimin prod', product_path(@product), data: {
                 turbo_method: :delete,
                 turbo_confirm: t('common.confirm')} %>                                                                                       
          </div>
        </div>
        <div class="col">
            <%= image_tag @product.photo, width: 400 if @product.photo.attached? %>
        </div>
          <%= link_to  "nuevo movimiento", new_movimient_product_path(@product), class:"btn btn-primary" %>
      </div>
     
  </div>

 <div class="shadow-lg p-3 mb-5 bg-body rounded">
 <h1>Movimientos</h1>
 <div class="table-responsive">
  <table class="table">
    
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Tipo De Movimiento</th>
      <th scope="col">Cantidad</th>
      <th scope="col">Descripcion</th>
    </tr>
  </thead>
  <tbody>
  <% @product.movimients.each do |movimient|%>
    <tr>
      <th scope="row"><%= movimient.id%></th>
      <td><%= movimient.movimient_type_name%></td>
      <td><%= movimient.cant%></td>
      <td><%= movimient.coment %></td>
      <td><%= movimient.created_at %></td>
      <td></td>
      
    </tr>
   <%end%>
  </tbody>


  </table>
</div>

 </div>