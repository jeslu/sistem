
  <%= form_with(model: servicio, id: dom_id(servicio), class: "form-group") do |form| %>
    <% if servicio.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(servicio.errors.count, "error") %> prohibited this servicio from being saved:</h2>

        <ul>
          <% servicio.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name_serv, style: "display: block" %>
      <%= form.text_field :name_serv, class: "form-control" %>
    </div>

    <div>
      <%= form.label :description, style: "display: block" %>
      <%= form.text_area :description, class: "form-control" %>
    </div>

    <div>
      <%= form.label :costo_serv, style: "display: block" %>
      <%= form.text_field :costo_serv, class: "form-control" %>
    </div>

    <div>
      <%= form.label :active, style: "display: block" %>
      <%= form.check_box :active, class: "form-check-input" %>
    </div>

    <div>
      
      <%= form.submit class: "btn btn-primary" %> | <%= link_to "CANCELAR", servicios_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
  

