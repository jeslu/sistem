
<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>  
    

      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <meta name="description" content="">
      <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors">
      <meta name="generator" content="Hugo 0.122.0">
      <title>Album example · Bootstrap v5.3</title>

      <link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/album/">

      

      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@docsearch/css@3">

    

     

    
  </head>
  <body>

    <main>


      <h1>Sistema CodeWeb</h1>

      <div class="album py-5 bg-body-tertiary">
        <div class="container">

          <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">


            <div class="col">
              <div class="card shadow-sm shadow-lg p-3 mb-5 bg-body rounded">
               <%= link_to  clients_url  do %>
                  <%= image_tag 'clientes.png', :class => "card-img-top", :size => "50x160" %>
                <div class="card-body">
                <h5 class="card-title"> CLIENTES</h5>
                  <p class="card-text">Un modulo donde puede realizar registro y estatus de cada clientes.</p>
                  <% end %>
                     <br>
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="btn-group">
                         <%= link_to  "REGISTRAR CLIENTES", new_client_path, class:"btn btn-sm btn-outline-primary " %>
                        
                    </div>
                    <small class="text-body-secondary">registrados:</small>
                  </div>
                </div>
              </div>
            </div>
            <div class="col">
              <div class="card shadow-sm shadow-lg p-3 mb-5 bg-body rounded">
               <%= link_to  sales_url  do %>
                <%= image_tag 'ventas.png', :class => "card-img-top", :size => "90x160" %>
                <div class="card-body">
                <h5 class="card-title">VENTAS</h5>
                  <p class="card-text">un modulo para generar alguna venta de nuestros productos</p>
                    <% end %>
                    <br>
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="btn-group">
                      <%= link_to  "REALIZAR VENTA", new_sale_path, class:"btn btn-sm btn-outline-primary" %>
                     
                    </div>
                    <small class="text-body-secondary">realizadas:</small>
                  </div>
                </div>
              </div>
            </div>
            <div class="col">
              <div class="card shadow-sm shadow-lg p-3 mb-5 bg-body rounded">
               <%= link_to products_url do %>
                <%= image_tag 'productos.png', :class => "card-img-top", :size => "90x160" %>
                <div class="card-body">
                <h5 class="card-title">PRODUCTOS</h5>
                  <p class="card-text">Es un modulo de invetario de nuestros productos</p>
                    <% end %>
                    <br>
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="btn-group">
                     <%= link_to  "REGISTRAR PRODUCTOS", new_product_path, class:"btn btn-sm btn-outline-primary" %>
                     
                    </div>
                    <small class="text-body-secondary">Registardos:</small>
                  </div>
                </div>
              </div>
            </div>

            <div class="col">
              <div class="card shadow-sm shadow-lg p-3 mb-5 bg-body rounded">
              <%= link_to  cotizs_url  do %>
                <%= image_tag 'cotizs.png', :class => "card-img-top", :size => "90x175" %>
                <div class="card-body">
                <h5 class="card-title">COTIZACIONES</h5>
                  <p class="card-text">Es un modulo para generar cotizaciones de nuestros servicios.</p>
                    <%end%>
                    <br>
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="btn-group">
                    <%= link_to  "REALIZAR COTIZACION", new_cotiz_path, class:"btn btn-sm btn-outline-primary" %>
                    </div>
                    <small class="text-body-secondary">Realizadas</small>
                  </div>
                </div>
              </div>
            </div>
            <div class="col">
              <div class="card shadow-sm shadow-lg p-3 mb-5 bg-body rounded">
                 <%= image_tag 'reparacion.jpg', :class => "card-img-top", :size => "90x160" %>
                <div class="card-body">
                <h5 class="card-title">REVICION</h5>
                  <p class="card-text">Un modulo donde se registar todo los equipos revisados y reparados</p>
                  <br>
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="btn-group">
                      <button type="button" class="btn btn-sm btn-outline-secondary">View</button>
                      <button type="button" class="btn btn-sm btn-outline-secondary">Edit</button>
                    </div>
                    <small class="text-body-secondary">revicion:</small>
                  </div>
                </div>
              </div>
            </div>
            <div class="col">
              <div class="card shadow-sm shadow-lg p-3 mb-5 bg-body rounded">
                <%= image_tag 'finanzas.jpeg', :class => "card-img-top", :size => "90x160" %>
                <div class="card-body">
                <h5 class="card-title">FINANZAS</h5>
                  <p class="card-text">Un modulo donde se administra todo el fondo del negocio</p>
                  <br>
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="btn-group">
                      <button type="button" class="btn btn-sm btn-outline-secondary">View</button>
                      <button type="button" class="btn btn-sm btn-outline-secondary">Edit</button>
                    </div>
                    <small class="text-body-secondary">fondo: $</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </main>

    <footer class="text-body-secondary py-5">
    <div class="container">
      <p class="float-end mb-1">
        <a href="#">Back to top</a>
      </p>
    
    </div>
    </footer>
  
  </body>
</html>






