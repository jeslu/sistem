<%= form_with(model: supplier, :class => "row g-3") do |form| %>
  <% if supplier.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(supplier.errors.count, "error") %> prohibited this supplier from being saved:</h2>

      <ul>
        <% supplier.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="col-md-4">
    <%= form.label :name_pro %>
    <%= form.text_field :name_pro, :class => "form-control", :placeholder => "EJEM. SECUCORE" %>
  </div>

  <div class="col-md-4">
    <%= form.label :cel_pro %>
    <%= form.text_field :cel_pro, :class=> "form-control", :placeholder => "ejem. 4425030233" %>
  </div>

  <div class="col-md-4">
    <%= form.label :direcction%>
    <%= form.text_field :direcction, :class => "form-control", :placeholder => "ej. FRANCISCO VILLA #1,SORIANO,COLON,QRO."  %>
  </div>

  <div class="col-md-4">
    <%= form.label :email_pro %>
    <%= form.text_field :email_pro, :class => "form-control", :placeholder => "ejem. jose@gmail.com" %>
  </div>

  <div class="col-md-4" >
    <%= form.label :nota %>
    <%= form.text_area :nota, :class => "form-control", :placeholder => "escribir notas importantes para hacer un pedido"  %>
  </div>

  <div>
    <%= form.submit 'Agregar', :class => "btn btn-primary"%>
  </div>
<% end %>
